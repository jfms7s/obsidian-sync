# Copy to /etc/obsync/obsync.env (root-owned, mode 0640). Optional: every
# value below is the built-in default unless noted. One KEY=value per line, no
# quotes needed. obsync needs no secrets in its default single-node setup.

# Address to listen on. The unit defaults to loopback so that a reverse proxy
# (Caddy, nginx) terminates TLS; obsync itself speaks plain HTTP.
OBSYNC_LISTEN=127.0.0.1:8080

# Where the database and blobs live. The unit's StateDirectory makes
# /var/lib/obsync the only writable path, so change this only together with it.
OBSYNC_DATA_DIR=/var/lib/obsync

# debug | info | warn | error
#OBSYNC_LOG_LEVEL=info

# Reverse proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For is
# believed. With the proxy on the same machine: 127.0.0.1,::1. Leave unset if
# clients connect directly; then every client is judged by its own address.
#OBSYNC_TRUSTED_PROXIES=127.0.0.1,::1

# Per-user storage quota and the largest single file, in bytes.
#OBSYNC_DEFAULT_QUOTA_BYTES=10737418240
#OBSYNC_MAX_FILE_SIZE_BYTES=2147483648

# History and trash retention (days; 0 = no limit, except trash which is >= 1).
#OBSYNC_HISTORY_DAYS=30
#OBSYNC_HISTORY_MAX_VERSIONS=0
#OBSYNC_TRASH_DAYS=30

# Garbage-collection grace for unreferenced chunks, and how often the
# maintenance jobs run.
#OBSYNC_GC_GRACE_HOURS=24
#OBSYNC_JOBS_INTERVAL_MINUTES=60

# Rate limits (requests per second and burst); 0 disables a limiter.
#OBSYNC_RATE_LIMIT_DEVICE_RPS=100
#OBSYNC_RATE_LIMIT_DEVICE_BURST=1000
#OBSYNC_RATE_LIMIT_IP_RPS=1
#OBSYNC_RATE_LIMIT_IP_BURST=10

# Alternatively point OBSYNC_CONFIG at a YAML file; OBSYNC_* values here
# override it.
#OBSYNC_CONFIG=/etc/obsync/obsync.yaml
