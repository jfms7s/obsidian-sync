[Unit]
Description=obsync end-to-end encrypted Obsidian sync server
Documentation=https://github.com/jfms7s/obsidian-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/obsync serve
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# Settings. The defaults below are overridden by anything in the file, which
# is optional (obsync needs no secrets). See obsync.env.example.
Environment=OBSYNC_LISTEN=127.0.0.1:8080
Environment=OBSYNC_DATA_DIR=/var/lib/obsync
EnvironmentFile=-/etc/obsync/obsync.env

# An unprivileged user (created by obsync.sysusers, see README), so that
# `sudo -u obsync obsync admin ...` works on the same data. Its only writable
# path is /var/lib/obsync (StateDirectory).
User=obsync
Group=obsync
StateDirectory=obsync
StateDirectoryMode=0700
UMask=0077

# Sandbox.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
