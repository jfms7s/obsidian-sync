# Copy to .env next to compose.yaml.

# Public host name that points at this machine; Caddy obtains a certificate
# for it. Ports 80 and 443 must be reachable from the internet.
OBSYNC_DOMAIN=sync.example.com

# Image tag to run (see https://github.com/jfms7s/obsidian-sync/pkgs/container/obsync).
# Pin a release rather than following latest.
OBSYNC_VERSION=latest
