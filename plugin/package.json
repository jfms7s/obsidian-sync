{
  "name": "obsync-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:convergence": "vitest run --project convergence"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "node-diff3": "3.2.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "22.19.1",
    "fake-indexeddb": "6.2.5",
    "obsidian": "1.8.7",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
