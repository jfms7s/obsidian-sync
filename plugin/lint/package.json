{
  "name": "obsync-plugin-lint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian's plugin lint rules, in a package of their own: typescript-eslint does not support the TypeScript 7 the plugin itself is built with.",
  "scripts": {
    "lint": "cd ../.. && plugin/lint/node_modules/.bin/eslint --config plugin/lint/eslint.config.mjs --max-warnings 0 plugin/src"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
